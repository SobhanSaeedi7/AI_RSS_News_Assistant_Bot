# AI RSS News Assistant - environment configuration
#
# Copy this file to `.env` (gitignored) and fill in the values before running
# locally. Never commit `.env` or any real secrets to version control.
#
# Values here are placeholders only. Replace them with your own.

# --- Telegram ---
# Bot token obtained from @BotFather. Required by the bot service and used by
# the worker to send automatic delivery messages.
BOT_TOKEN=

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
# The bot and worker are separate processes that share persistent data, so
# they connect to the same PostgreSQL database (service name `db` in Compose).
POSTGRES_DB=ai_rss_news
POSTGRES_USER=ai_rss_news
POSTGRES_PASSWORD=
# DATABASE_URL is derived by Compose from POSTGRES_USER/PASSWORD/DB above.
# When running without Compose, set a full PostgreSQL connection URL here:
# DATABASE_URL=postgresql+asyncpg://ai_rss_news:password@localhost:5432/ai_rss_news
DATABASE_URL=

# --- LLM (optional) ---
# Any OpenAI-compatible chat completions endpoint works. The worker uses it for
# automatic delivery summaries and the agent uses it to answer /ask questions.
# When LLM_API_KEY is empty the worker delivers trimmed article text instead of
# a summary and /ask reports that AI answers are unavailable.
LLM_API_KEY=
LLM_BASE_URL=https://api.avalai.ir/v1
LLM_MODEL=gpt-6-luna
LLM_TIMEOUT_SECONDS=30

# --- Agent service (internal answer API) ---
# Shared bearer token for the internal agent API: the bot sends it and the
# agent requires it. Both services read the same value. Generate a long random
# one, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# While this is empty the agent starts but refuses every request (503).
AGENT_INTERNAL_TOKEN=
# Base URL the bot uses to reach the agent (the Compose service name).
AGENT_BASE_URL=http://agent:8000
# Bind address and port of the agent inside the container network. The agent
# publishes no host port; do not expose it publicly.
AGENT_HOST=0.0.0.0
AGENT_PORT=8000
# Outer timeout in seconds for one bot -> agent request. Keep it larger than
# LLM_TIMEOUT_SECONDS so the agent can report its own provider timeout first.
AGENT_TIMEOUT_SECONDS=40

# --- Fetching and worker tuning (optional) ---
# Seconds between RSS polling runs.
POLL_INTERVAL_SECONDS=300
# Fetch and store full article text for items that only have an RSS summary.
FETCH_FULL_TEXT=true
# Timeout in seconds for one outbound fetch: the bot's /addfeed probe, the
# worker's feed polling, and the worker's article full-text fetch.
FETCH_TIMEOUT_SECONDS=30
